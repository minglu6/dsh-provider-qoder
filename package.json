{
  "name": "@lightmanlu/dsh-provider-qoder",
  "version": "0.1.2",
  "description": "Qoder CN adapter plugin for DeepSeek Harness: COSY-signed, WAF-encoded streaming against gateway.qoder.com.cn",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qoder",
    "llm",
    "provider"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-timeout": "~0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-values": "~0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minglu6/dsh-provider-qoder.git"
  },
  "bugs": {
    "url": "https://github.com/minglu6/dsh-provider-qoder/issues"
  },
  "homepage": "https://github.com/minglu6/dsh-provider-qoder#readme"
}
